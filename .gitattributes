# Normalize line endings: store LF in repo, checkout as native
* text=auto

# Force LF for source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.mts  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.glsl text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.sh   text eol=lf

# Binary files — no text conversion
*.ico  binary
*.icns binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
