{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "electron",
    "shared",
    "vite.config.mts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests-e2e"
  ]
}
